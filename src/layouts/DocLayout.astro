---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import { siteConfig, contentBase, sections } from "../config";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Toc from "../components/Toc.astro";
import PrevNext from "../components/PrevNext.astro";
import Analytics from "../components/Analytics.astro";
import ClientEnhancements from "../components/ClientEnhancements.astro";
import "../styles/global.css";

interface Props {
  entry: CollectionEntry<"docs">;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const editUrl = `${siteConfig.links.docs}/edit/main/${contentBase}/${entry.id}.md`;
const sectionLabel = sections.find((s) => s.key === entry.data.section)?.label ?? "Docs";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{entry.data.title} — {siteConfig.name}</title>
    <meta name="description" content={entry.data.description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="color-scheme" content="light" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap"
    />
    <Analytics />
    <meta property="og:title" content={entry.data.title} />
    <meta property="og:description" content={entry.data.description} />
    <meta property="og:type" content="article" />
  </head>
  <body class="bg-cream text-ink-950">
    <Header />

    <!-- mobile nav: a <details> element — zero JS, works everywhere -->
    <div class="border-b-2 border-ink-950 bg-paper lg:hidden">
      <details>
        <summary
          class="mx-auto flex h-11 max-w-7xl cursor-pointer list-none items-center gap-2 px-4 text-sm font-medium text-stone-600 sm:px-6"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          Menu
        </summary>
        <div class="max-h-[70vh] overflow-y-auto border-t-2 border-ink-950/15 px-4 py-4 sm:px-6">
          <Sidebar />
        </div>
      </details>
    </div>

    <div class="mx-auto flex max-w-7xl gap-10 px-4 sm:px-6">
      <!-- desktop sidebar -->
      <aside class="sticky top-[70px] hidden h-[calc(100vh-70px)] w-60 shrink-0 overflow-y-auto py-8 lg:block">
        <Sidebar />
      </aside>

      <main class="min-w-0 flex-1 py-8 sm:py-10">
        <!-- page title: chunky display headline + section eyebrow -->
        <header class="mb-8 max-w-[52rem]">
          <p class="font-mono text-[10.5px] font-semibold uppercase tracking-[0.16em] text-stone-500">
            {sectionLabel}
          </p>
          <h1 class="mt-2 font-display text-4xl font-bold uppercase leading-[1.05] tracking-tight text-ink-950 sm:text-5xl">
            {entry.data.title}
          </h1>
          <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-stone-600">
            {entry.data.description}
          </p>
        </header>

        <article class="prose max-w-[52rem]">
          <slot />
        </article>

        <div class="max-w-[52rem]">
          <PrevNext />
        </div>

        <footer class="mt-6 max-w-[52rem] border-t-2 border-ink-950/15 pt-4 text-sm">
          <a
            href={editUrl}
            class="font-mono text-[12px] text-stone-500 underline decoration-ink-950/30 underline-offset-4 hover:text-ink-950 hover:decoration-ink-950"
            rel="noopener noreferrer" target="_blank">Edit this page on GitHub</a
          >
        </footer>
      </main>

      <div class="hidden w-56 shrink-0 py-10 xl:block">
        <Toc headings={headings} />
      </div>
    </div>

    <ClientEnhancements />
  </body>
</html>
