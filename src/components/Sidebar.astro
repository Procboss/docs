---
import { getCollection } from "astro:content";
import { sections } from "../config";

/** Ordered nav tree: sections from config, entries sorted by frontmatter order. */
const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const groups = sections
  .map((sec) => ({ ...sec, items: docs.filter((d) => d.data.section === sec.key) }))
  .filter((g) => g.items.length > 0);

const href = (id: string) => (id === "intro" ? "/" : `/${id}`);
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (id: string) => href(id) === current;
---

<!-- paper sidebar: mono uppercase section labels, active item = mint sticker -->
<nav aria-label="Docs navigation">
  {
    groups.map((group) => (
      <div class="mb-6">
        <p class="mb-2 px-1 font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-stone-500">
          {group.label}
        </p>
        <ul class="space-y-1">
          {group.items.map((entry) => (
            <li>
              <a
                href={href(entry.id)}
                aria-current={isActive(entry.id) ? "page" : undefined}
                class:list={[
                  "block rounded-lg border-2 px-3 py-1.5 text-[13.5px] transition-all",
                  isActive(entry.id)
                    ? "border-ink-950 bg-mint-200 font-semibold text-ink-950 shadow-brutal-xs"
                    : "border-transparent text-stone-600 hover:bg-cream-deep hover:text-ink-950",
                ]}
              >
                {entry.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</nav>
