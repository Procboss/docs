---
import { getCollection } from "astro:content";
import { sections } from "../config";

/** Flattened reading order across all sections — drives prev/next. */
const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const order = sections
  .flatMap((sec) => docs.filter((d) => d.data.section === sec.key))
  .map((d) => d.id);

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const idx = order.findIndex((id) => (id === "intro" ? "/" : `/${id}`) === current);
const prev = idx > 0 ? order[idx - 1] : null;
const next = idx >= 0 && idx < order.length - 1 ? order[idx + 1] : null;

const all = new Map(docs.map((d) => [d.id, d.data.title]));
const href = (id: string) => (id === "intro" ? "/" : `/${id}`);
---

{
  (prev || next) && (
    <div class="mt-14 grid gap-4 border-t-2 border-ink-950/15 pt-8 sm:grid-cols-2">
      <div>
        {prev && (
          <a href={href(prev)} class="group block rounded-xl border-2 border-ink-950 bg-paper p-4 shadow-brutal-xs transition-all hover:-translate-y-0.5 hover:shadow-brutal-sm">
            <span class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-stone-500">← Previous</span>
            <p class="mt-1 text-sm font-semibold text-ink-950">{all.get(prev)}</p>
          </a>
        )}
      </div>
      <div class="sm:text-right">
        {next && (
          <a href={href(next)} class="group block rounded-xl border-2 border-ink-950 bg-paper p-4 shadow-brutal-xs transition-all hover:-translate-y-0.5 hover:shadow-brutal-sm">
            <span class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-stone-500">Next →</span>
            <p class="mt-1 text-sm font-semibold text-ink-950">{all.get(next)}</p>
          </a>
        )}
      </div>
    </div>
  )
}
