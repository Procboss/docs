---
import { getCollection } from "astro:content";
import { sections } from "../config";

/** Flattened reading order across all sections — drives prev/next. */
const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const order = sections
  .flatMap((sec) => docs.filter((d) => d.data.section === sec.key))
  .map((d) => d.id);

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const idx = order.findIndex((id) => (id === "intro" ? "/" : `/${id}`) === current);
const prev = idx > 0 ? order[idx - 1] : null;
const next = idx >= 0 && idx < order.length - 1 ? order[idx + 1] : null;

const all = new Map(docs.map((d) => [d.id, d.data.title]));
const href = (id: string) => (id === "intro" ? "/" : `/${id}`);
---

{
  (prev || next) && (
    <div class="mt-12 grid gap-4 border-t border-zinc-200 pt-6 sm:grid-cols-2 dark:border-zinc-800">
      <div>
        {prev && (
          <a href={href(prev)} class="group block rounded-lg border border-zinc-200 p-4 transition-colors hover:border-emerald-300 dark:border-zinc-800 dark:hover:border-emerald-800">
            <span class="text-xs text-zinc-400 dark:text-zinc-500">Previous</span>
            <p class="mt-1 text-sm font-medium text-zinc-900 group-hover:text-emerald-600 dark:text-zinc-100 dark:group-hover:text-emerald-400">{all.get(prev)}</p>
          </a>
        )}
      </div>
      <div class="sm:text-right">
        {next && (
          <a href={href(next)} class="group block rounded-lg border border-zinc-200 p-4 transition-colors hover:border-emerald-300 dark:border-zinc-800 dark:hover:border-emerald-800">
            <span class="text-xs text-zinc-400 dark:text-zinc-500">Next</span>
            <p class="mt-1 text-sm font-medium text-zinc-900 group-hover:text-emerald-600 dark:text-zinc-100 dark:group-hover:text-emerald-400">{all.get(next)}</p>
          </a>
        )}
      </div>
    </div>
  )
}
