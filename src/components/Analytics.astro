---
/**
 * Google Analytics (gtag.js).
 *
 * Reads PUBLIC_GA_ID at BUILD time (Astro exposes PUBLIC_* vars via
 * import.meta.env). Set it in Cloudflare Pages → Settings → Environment
 * variables, then trigger a rebuild — the ID is inlined into the static HTML.
 * When the variable is unset (local dev, forks) nothing is rendered at all,
 * so no GA request is ever made.
 */
const GA_ID = import.meta.env.PUBLIC_GA_ID as string | undefined;
---

{
  GA_ID && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
      <script define:vars={{ GA_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', GA_ID);
      </script>
    </>
  )
}
