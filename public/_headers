# Cloudflare Pages headers — docs.procboss.com
#
# The AI-friendly duplicate surfaces (.md mirrors, llms.txt dumps) are for
# machines, not search indexes: the HTML page is the canonical copy, so the
# mirrors carry X-Robots-Tag: noindex. Crawling is allowed (robots.txt says
# Allow) — indexing duplicates is not.

/*.md
  X-Robots-Tag: noindex
  Content-Type: text/markdown; charset=utf-8

/llms.txt
  X-Robots-Tag: noindex
  Content-Type: text/markdown; charset=utf-8

/llms-full.txt
  X-Robots-Tag: noindex
  Content-Type: text/markdown; charset=utf-8

/rss.xml
  Content-Type: application/rss+xml; charset=utf-8

/sitemap-index.xml
  Content-Type: application/xml; charset=utf-8

/sitemap-*.xml
  Content-Type: application/xml; charset=utf-8
