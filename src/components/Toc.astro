---
import type { MarkdownHeading } from "astro";

/** "On this page" — from the h2/h3 headings Astro slugified at build time. */
const { headings } = Astro.props as { headings: MarkdownHeading[] };
const toc = (headings ?? []).filter((h) => h.depth === 2 || h.depth === 3);
---

{
  toc.length > 1 && (
    <nav aria-label="Table of contents" class="sticky top-24 hidden max-h-[calc(100vh-7rem)] overflow-y-auto py-2 xl:block">
      <p class="mb-2.5 font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-stone-500">On this page</p>
      <ul class="space-y-1.5 border-l-2 border-ink-950/15">
        {toc.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              class:list={[
                "block border-l-2 text-[13px] leading-5 transition-colors",
                h.depth === 2
                  ? "-ml-0.5 pl-3 border-ink-950/40 font-medium text-stone-700 hover:border-ink-950 hover:text-ink-950"
                  : "-ml-0.5 pl-7 border-transparent text-stone-500 hover:border-ink-950/40 hover:text-ink-950",
              ]}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
