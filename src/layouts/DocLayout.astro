---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import { siteConfig, contentBase } from "../config";
import { buildGraph, OG_IMAGE, OG_IMAGE_ALT, sectionLabelFor } from "../lib/seo";
import { getLastmodMap } from "../lib/lastmod.mjs";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Toc from "../components/Toc.astro";
import PrevNext from "../components/PrevNext.astro";
import Analytics from "../components/Analytics.astro";
import ClientEnhancements from "../components/ClientEnhancements.astro";
import "../styles/global.css";

interface Props {
  entry: CollectionEntry<"docs">;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const editUrl = `${siteConfig.links.docs}/edit/main/${contentBase}/${entry.id}.md`;
const sectionLabel = sectionLabelFor(entry.data.section) || "Docs";

// --- SEO facts ---------------------------------------------------------------
// Build-format is "directory", so pathnames are trailing-slashed ("/cli/daemon/");
// normalized defensively anyway. The index IS the intro page.
const path = Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/?$/, "/");
const isIndex = entry.id === "intro";
const dateModified = getLastmodMap().get(entry.id) ?? new Date().toISOString();
const canonical = new URL(path, Astro.site).href;
const graph = buildGraph(
  {
    path,
    title: entry.data.title,
    description: entry.data.description,
    sectionKey: entry.data.section,
    dateModified,
  },
  isIndex,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{entry.data.title} — {siteConfig.name}</title>
    <meta name="description" content={entry.data.description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f4f1ea" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap"
    />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.name} href="/rss.xml" />
    <!-- The machine surfaces: this page as raw markdown + the LLM site map -->
    <link rel="alternate" type="text/markdown" href={isIndex ? "/intro.md" : `${path.replace(/\/$/, "")}.md`} />
    <Analytics />
    <!-- Open Graph -->
    <meta property="og:title" content={entry.data.title} />
    <meta property="og:description" content={entry.data.description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="en" />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta property="article:section" content={sectionLabel} />
    <meta property="article:modified_time" content={dateModified} />
    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={entry.data.title} />
    <meta name="twitter:description" content={entry.data.description} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />
    <!-- Structured data: WebSite + Organization + TechArticle (+ SoftwareApplication on
         the index) + BreadcrumbList, one @graph per page. -->
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body class="bg-cream text-ink-950">
    <Header />

    <!-- mobile nav: a <details> element — zero JS, works everywhere -->
    <div class="border-b-2 border-ink-950 bg-paper lg:hidden">
      <details>
        <summary
          class="mx-auto flex h-11 max-w-7xl cursor-pointer list-none items-center gap-2 px-4 text-sm font-medium text-stone-600 sm:px-6"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          Menu
        </summary>
        <div class="max-h-[70vh] overflow-y-auto border-t-2 border-ink-950/15 px-4 py-4 sm:px-6">
          <Sidebar />
        </div>
      </details>
    </div>

    <div class="mx-auto flex max-w-7xl gap-10 px-4 sm:px-6">
      <!-- desktop sidebar -->
      <aside class="sticky top-[70px] hidden h-[calc(100vh-70px)] w-60 shrink-0 overflow-y-auto py-8 lg:block">
        <Sidebar />
      </aside>

      <!-- pagefind: main is the index scope — headers/sidebars/TOC stay out
           of search; the h1 carries the result title; prev/next + footer are
           chrome, not content -->
      <main class="min-w-0 flex-1 py-8 sm:py-10" data-pagefind-body>
        <!-- page title: chunky display headline + section eyebrow -->
        <header class="mb-8 max-w-[52rem]">
          <p class="font-mono text-[10.5px] font-semibold uppercase tracking-[0.16em] text-stone-500">
            {sectionLabel}
          </p>
          <h1 class="mt-2 font-display text-4xl font-bold uppercase leading-[1.05] tracking-tight text-ink-950 sm:text-5xl" data-pagefind-meta="title">
            {entry.data.title}
          </h1>
          <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-stone-600">
            {entry.data.description}
          </p>
        </header>

        <article class="prose max-w-[52rem]">
          <slot />
        </article>

        <div class="max-w-[52rem]" data-pagefind-ignore>
          <PrevNext />
        </div>

        <footer class="mt-6 max-w-[52rem] border-t-2 border-ink-950/15 pt-4 text-sm" data-pagefind-ignore>
          <a
            href={editUrl}
            class="font-mono text-[12px] text-stone-500 underline decoration-ink-950/30 underline-offset-4 hover:text-ink-950 hover:decoration-ink-950"
            rel="noopener noreferrer" target="_blank">Edit this page on GitHub</a
          >
        </footer>
      </main>

      <div class="hidden w-56 shrink-0 py-10 xl:block">
        <Toc headings={headings} />
      </div>
    </div>

    <ClientEnhancements />
  </body>
</html>
