---
import { siteConfig } from "../config";

const { links, product, productVersion } = siteConfig;
---

<!-- procboss paper header: cream bar, thick ink underline, logo + wordmark,
     version sticker, quiet nav. Single light theme. -->
<header class="sticky top-0 z-40 border-b-2 border-ink-950 bg-paper/95 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-3 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2 font-bold text-ink-950">
      <img src="/favicon.svg" alt="pboss logo" width="26" height="26" class="h-[26px] w-[26px]" />
      <span class="text-[15px] tracking-tight">{product}<span class="text-boss-600">.docs</span></span>
    </a>

    <span
      class="hidden rounded-md border-2 border-ink-950 bg-mint-200 px-1.5 py-0.5 font-mono text-[9.5px] font-bold uppercase text-ink-950 sm:inline"
    >{productVersion}</span>

    <nav class="ml-auto flex items-center gap-1 text-sm">
      <a
        href="/cli/processes"
        class="hidden rounded-md px-3 py-1.5 font-medium text-stone-600 hover:bg-cream-deep hover:text-ink-950 sm:block"
        aria-label="CLI reference">CLI</a
      >
      <a
        href="/cloud"
        class="hidden rounded-md px-3 py-1.5 font-medium text-stone-600 hover:bg-cream-deep hover:text-ink-950 sm:block"
        aria-label="ProcBoss Cloud docs">Cloud</a
      >
      <a
        href={links.cloud}
        class="rounded-lg border-2 border-ink-950 bg-boss-400 px-3 py-1.5 text-[13px] font-bold text-ink-950 shadow-brutal-xs transition-all hover:-translate-y-0.5 hover:shadow-brutal-sm active:translate-y-0.5 active:shadow-none"
        aria-label="procboss.com">procboss.com</a
      >
      <a
        href={links.pboss}
        class="flex items-center rounded-lg border-2 border-ink-950 bg-paper p-2 text-ink-950 shadow-brutal-xs transition-all hover:-translate-y-0.5 hover:shadow-brutal-sm active:translate-y-0.5 active:shadow-none"
        aria-label="pboss on GitHub"
        rel="noopener noreferrer" target="_blank">
        <svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>
    </nav>
  </div>
</header>
