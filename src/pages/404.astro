---
import { siteConfig } from "../config";
import Header from "../components/Header.astro";
import Analytics from "../components/Analytics.astro";
import ClientEnhancements from "../components/ClientEnhancements.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found — {siteConfig.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="color-scheme" content="light" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap"
    />
    <Analytics />
  </head>
  <body class="bg-cream text-ink-950">
    <Header />
    <main class="mx-auto flex min-h-[60vh] max-w-7xl flex-col items-center justify-center gap-5 px-4 py-24 text-center">
      <!-- the boss saw this page go down -->
      <svg viewBox="0 0 100 100" class="h-20 w-20" aria-hidden="true">
        <rect x="16" y="16" width="80" height="80" rx="22" fill="#13111c"></rect>
        <rect x="9" y="9" width="80" height="80" rx="22" fill="#ffd9a5" stroke="#13111c" stroke-width="6"></rect>
        <line x1="9" y1="30" x2="89" y2="30" stroke="#13111c" stroke-width="5"></line>
        <circle cx="25" cy="19.5" r="4.2" fill="#13111c"></circle>
        <circle cx="37" cy="19.5" r="4.2" fill="#13111c"></circle>
        <circle cx="49" cy="19.5" r="4.2" fill="#13111c"></circle>
        <circle cx="37" cy="58" r="15.5" fill="#ffffff" stroke="#13111c" stroke-width="6"></circle>
        <circle cx="63" cy="58" r="15.5" fill="#ffffff" stroke="#13111c" stroke-width="6"></circle>
        <circle cx="33.5" cy="60" r="5.5" fill="#13111c"></circle>
        <circle cx="66.5" cy="60" r="5.5" fill="#13111c"></circle>
      </svg>
      <p class="font-mono text-[12px] font-semibold uppercase tracking-[0.2em] text-stone-500">error 404</p>
      <h1 class="font-display text-4xl font-bold uppercase tracking-tight sm:text-5xl">This page went offline</h1>
      <p class="max-w-md text-[15px] leading-relaxed text-stone-600">
        The page you are looking for was stopped, deleted, or never started.
      </p>
      <a
        href="/"
        class="mt-1 rounded-xl border-2 border-ink-950 bg-boss-400 px-5 py-2.5 text-[14px] font-bold text-ink-950 shadow-brutal-sm transition-all hover:-translate-y-0.5 hover:shadow-brutal active:translate-y-0.5 active:shadow-brutal-xs"
        >Back to the docs</a
      >
    </main>

    <ClientEnhancements />
  </body>
</html>
